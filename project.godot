; Engine configuration file.
config_version=5

[application]

config/name="SHIFT WORLDS"
config/description="A puzzle-platformer about shifting between two parallel worlds."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.024, 0.071, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="ShiftWorlds"

[autoload]

Game="*res://scripts/game.gd"
Sound="*res://scripts/sound.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=272
window/size/window_width_override=1440
window/size/window_height_override=816
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.024, 0.071, 1)
